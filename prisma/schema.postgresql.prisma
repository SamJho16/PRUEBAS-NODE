// ==========================================================
// Esquema de despliegue para PostgreSQL (Render).
// Mantener sincronizado con schema.prisma, que se usa con SQLite local.
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                                  String             @id @default(uuid())
  email                               String             @unique
  nombre                              String
  fotoPerfil                          String?
  proveedorAuth                       String
  proveedorId                         String
  rol                                 String?
  estado                              String             @default("ACTIVO")
  creadoEn                            DateTime           @default(now())
  actualizadoEn                       DateTime           @updatedAt
  perfilAsesor                        PerfilAsesor?
  perfilCliente                       PerfilCliente?
  publicaciones                       Publicacion[]
  comentarios                         Comentario[]
  reacciones                          Reaccion[]
  evaluacionesRecibidasComoAsesor     EvaluacionAsesor[] @relation("AsesorEvaluado")
  evaluacionesHechasComoCliente       EvaluacionAsesor[] @relation("ClienteEvaluador")
  evaluacionesRecibidasComoCliente    EvaluacionCliente[] @relation("ClienteEvaluado")
  evaluacionesHechasComoAsesor        EvaluacionCliente[] @relation("AsesorEvaluador")
  refreshTokens                       RefreshToken[]

  @@unique([proveedorAuth, proveedorId])
  @@index([rol])
}

model PerfilAsesor {
  id                         String             @id @default(uuid())
  usuarioId                  String             @unique
  usuario                    Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estadoVerificacion         String             @default("NO_VERIFICADO")
  documentoIdentidadFrontal  String?
  documentoIdentidadSello    String?
  fechaSolicitudVerificacion DateTime?
  fechaVerificacion          DateTime?
  motivoRechazo              String?
  creadoEn                   DateTime           @default(now())
  actualizadoEn              DateTime           @updatedAt
}

model PerfilCliente {
  id            String   @id @default(uuid())
  usuarioId     String   @unique
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Publicacion {
  id              String            @id @default(uuid())
  autorId         String
  autor           Usuario           @relation(fields: [autorId], references: [id], onDelete: Cascade)
  autorRol        String
  titulo          String
  contenido       String
  estado          String            @default("ACTIVA")
  totalComentarios Int               @default(0)
  totalReacciones Int                @default(0)
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  comentarios     Comentario[]
  reacciones      Reaccion[]

  @@index([autorRol, estado])
  @@index([autorId])
}

model Comentario {
  id            String      @id @default(uuid())
  publicacionId String
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  autorId       String
  autor         Usuario     @relation(fields: [autorId], references: [id], onDelete: Cascade)
  contenido     String
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt

  @@index([publicacionId])
}

model Reaccion {
  id            String       @id @default(uuid())
  publicacionId String
  publicacion   Publicacion  @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo          String       @default("ME_INTERESA")
  creadoEn      DateTime     @default(now())

  @@unique([publicacionId, usuarioId])
}

model EvaluacionAsesor {
  id            String   @id @default(uuid())
  asesorId      String
  asesor        Usuario  @relation("AsesorEvaluado", fields: [asesorId], references: [id], onDelete: Cascade)
  clienteId     String
  cliente       Usuario  @relation("ClienteEvaluador", fields: [clienteId], references: [id], onDelete: Cascade)
  calificacion  Int
  confiabilidad Int
  compromiso    Int
  eficiencia    Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([asesorId, clienteId])
}

model EvaluacionCliente {
  id            String   @id @default(uuid())
  clienteId     String
  cliente       Usuario  @relation("ClienteEvaluado", fields: [clienteId], references: [id], onDelete: Cascade)
  asesorId      String
  asesor        Usuario  @relation("AsesorEvaluador", fields: [asesorId], references: [id], onDelete: Cascade)
  calificacion  Int
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([clienteId, asesorId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiraEn  DateTime
  revocado  Boolean  @default(false)
  creadoEn  DateTime @default(now())

  @@index([usuarioId])
}
