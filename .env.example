# ==========================================
# Variables de entorno - PROYECTOH Backend
# Copiar este archivo como ".env" y completar
# ==========================================

# --- Servidor ---
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# --- Base de datos local (SQLite) ---
# Usada por Prisma durante el desarrollo local.
DATABASE_URL="file:./dev.db"

# --- JWT ---
JWT_ACCESS_SECRET="cambia-esta-clave-de-acceso-por-una-segura"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="cambia-esta-clave-de-refresh-por-una-segura"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- OAuth Google ---
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"

# --- OAuth Facebook ---
FACEBOOK_APP_ID="tu-facebook-app-id"
FACEBOOK_APP_SECRET="tu-facebook-app-secret"

# --- API Key para endpoints internos (service-to-service) ---
INTERNAL_API_KEY="cambia-esta-api-key-interna"

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"

# --- Uploads (documentos de verificacion) ---
UPLOADS_DIR="uploads"
